PORT=3000
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://127.0.0.1:6333
COLLECTION=global_memory
MEMORY_COLLECTION=contextual_memory
DATA_DIR=data
EMBED_MODEL=nomic-embed-text
CONTEXT_AWARE_RETRIEVAL=true

# Production authentication: set these through your secret manager or shell,
# never commit a real value. JWT_SECRET is required when NODE_ENV=production.
# NODE_ENV=production
# AUTH_MODE=jwt
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_ISSUER=optional-issuer
# JWT_AUDIENCE=optional-audience
# JWT_TENANT_CLAIM=tenantId

# Local Continue MCP development. `node scripts/continue-mcp.mjs` reads these
# values from the local ignored .env and creates a short-lived JWT in its child process.
# AUTH_MODE=jwt
# JWT_SECRET=required-local-secret
# CONTINUE_MEMORY_TENANT_ID=continue-local
# CONTINUE_MEMORY_SUBJECT=continue-mcp
# CONTINUE_MEMORY_JWT_TTL_SECONDS=14400
# MEMORY_SERVICE_URL=http://localhost:3000
